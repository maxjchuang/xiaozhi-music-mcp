# 从小智控制台的「配置角色 → MCP 接入点」复制。不要把真实 Token 提交到 Git。
MCP_ENDPOINT=wss://api.xiaozhi.me/mcp/?token=REPLACE_WITH_A_NEW_TOKEN
LOG_LEVEL=INFO
MUSIC_PROXY_PORT=8765
MUSIC_PROXY_STREAM_TTL=1800
MUSIC_PROVIDER_TIMEOUT_SECONDS=20

# 本地优先的使用行为统计。飞书未登录或不可用时不会阻止音乐服务。
ANALYTICS_ENABLED=true
ANALYTICS_TRANSCRIPT_MODE=masked
# 默认数据库：~/.local/state/xiaozhi/analytics.sqlite3
ANALYTICS_DATABASE_PATH=
# 部署时请生成随机值，修改后同一设备会产生新的匿名标识。
ANALYTICS_DEVICE_SALT=

# 飞书同步默认关闭；完成 lark-cli 登录和 Base 初始化后再启用。
FEISHU_ANALYTICS_ENABLED=false
FEISHU_AUTH_REQUIRED_ON_START=false
# 默认从 PATH 查找；仅在自定义安装位置时填写。
LARK_CLI_BIN=
FEISHU_BASE_TOKEN=
FEISHU_EVENT_TABLE_ID=
FEISHU_SESSION_TABLE_ID=
FEISHU_PLAY_TABLE_ID=
FEISHU_DASHBOARD_ID=
FEISHU_SYNC_BATCH_SIZE=10
FEISHU_SYNC_INTERVAL_SECONDS=10

# 严格按照这里的顺序搜索；未配置的 Provider 会自动跳过。
MUSIC_PROVIDER_ORDER=navidrome,netease,fangpi,jamendo,unofficial

# 本地音乐库（推荐优先配置）
NAVIDROME_URL=http://127.0.0.1:4533
NAVIDROME_USERNAME=
NAVIDROME_PASSWORD=
# 已由 NAS、Docker 或 brew services 管理时保持 false。需要统一管理时填写目录和 JSON 命令数组。
NAVIDROME_SERVICE_MANAGED=false
NAVIDROME_SERVICE_DIR=
NAVIDROME_SERVICE_COMMAND=

# https://developer.jamendo.com/v3.0 获取 Client ID
JAMENDO_CLIENT_ID=

# 自托管 NeteaseCloudMusicApiEnhanced；只接受平台原生完整歌曲，过滤 30 秒试听。
# API 服务端必须保持 ENABLE_GENERAL_UNBLOCK=false。
NETEASE_PROVIDER_ENABLED=false
NETEASE_API_URL=http://127.0.0.1:3000
NETEASE_API_TIMEOUT_SECONDS=12
# 本机端点默认由 music_service.sh 自动管理，通常无需修改。
NETEASE_SERVICE_MANAGED=true
NETEASE_SERVICE_DIR=~/.local/share/xiaozhi/netease-api-enhanced
NETEASE_SERVICE_COMMAND=["npm","start"]

# Fangpi 默认启用；遇到 Cloudflare 403 时按 PROVIDERS.md 手动配置 Cookie。
FANGPI_PROVIDER_ENABLED=true
FANGPI_API_TIMEOUT_SECONDS=10
FANGPI_COOKIE=
FANGPI_USER_AGENT=

# 可选实验源，默认关闭。接口约定见 PROVIDERS.md。
UNOFFICIAL_PROVIDER_ENABLED=false
UNOFFICIAL_PROVIDER_URL=
UNOFFICIAL_PROVIDER_TOKEN=
UNOFFICIAL_SERVICE_MANAGED=false
UNOFFICIAL_SERVICE_DIR=
UNOFFICIAL_SERVICE_COMMAND=
